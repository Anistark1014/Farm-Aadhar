# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application base URL (update for production)
VITE_APP_URL=https://farmaadhar.nexverse.in/
VITE_APP_NAME=Farm Aadhar

# API endpoints - For local development, use local endpoints
VITE_API_BASE_URL=https://farmaadhar.nexverse.in/api

# ============================================================================
# ESP32 CONFIGURATION (Optional - only if using ESP32 API authentication)
# ============================================================================
# Note: ESP32 sends data directly to Supabase database, no API key needed
# VITE_ESP32_API_KEY=your_esp32_api_key_here
# VITE_ESP32_NODES=air_node_01,simulation-node

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features
VITE_ENABLE_NEWS=true
VITE_ENABLE_AUTOMATION=true
VITE_ENABLE_CROP_PROFILES=true
VITE_ENABLE_PWA=true
VITE_ENABLE_REALTIME=true

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================
# Google Analytics (if you want to add tracking)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Enable debug mode
VITE_DEBUG=false

# Log level: error, warn, info, debug
VITE_LOG_LEVEL=info

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# Uncomment and update for production deployment
# VITE_APP_URL=https://farmaadhar.nexverse.in
# VITE_API_BASE_URL=https://farmaadhar.nexverse.in/api
# VITE_DEBUG=false
